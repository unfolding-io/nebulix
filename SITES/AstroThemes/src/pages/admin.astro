---
/* SVELTIA CMS ADMIN */
import { menu, page, settings, post, project } from "@cms/index.mjs";

const lang = import.meta.env.WEBSITE_LANGUAGE;
const url = Astro.site;

const config = {
  locale: lang,
  site_url: url,
  logo_url: "https://nebulix.unfolding.io/logo.svg",
  local_backend: true,
  backend: {
    name: "test-repo",
  },
  search: true,
  media_folder: "src/assets",
  public_folder: "/src/assets",
  media_library: {
    max_file_size: 2012000,
  },
  collections: [page, post, project, menu, settings],
};
---

<!doctype html>
<html lang={lang || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Nebulix Admin | by unfolding.io</title>
  </head>
  <body>
    <script is:inline define:vars={{ config }}>
      window.CMS_MANUAL_INIT = true;
      window.__NEBULIX_CMS_CONFIG__ = config;
    </script>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"
    ></script>
    <script is:inline>
      const boot = () => {
        const cfg = window.__NEBULIX_CMS_CONFIG__;
        if (typeof window.initCMS === "function") {
          window.initCMS({ config: cfg });
          return;
        }
        if (window.CMS && typeof window.CMS.init === "function") {
          window.CMS.init({ config: cfg });
        }
      };
      if (window.CMS || window.initCMS) boot();
      else document.addEventListener("DOMContentLoaded", boot);
    </script>
  </body>
</html>
