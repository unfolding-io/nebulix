---
import { marked } from "marked";
import { getGridImageSizes } from "@util/helpers";
import PageLayoutWide from "@layouts/PageLayoutWide.astro";
import PageLayoutSplit from "@layouts/PageLayoutSplit.astro";
import Pager from "@components/navigation/Pager.astro";
import ItemCard from "@components/cards/ItemCard.astro";
import ItemCardFlex from "@components/cards/ItemCardFlex.astro";
import ItemCardSmall from "@components/cards/ItemCardSmall.astro";
import { slugify } from "@util/helpers";
import type { CollectionEntry } from "astro:content";
import type { PageStyle } from "@src/types/page-style";

type ArchiveEntry = CollectionEntry<"blog"> | CollectionEntry<"project">;

interface ArchivePageData {
  body?: string;
  style?: PageStyle;
  [key: string]: unknown;
}

interface Props {
  data: ArchivePageData;
  page: {
    data: ArchiveEntry[];
    lastPage: number;
    currentPage: number;
  };
  filters?: string[];
  base_url: string;
  filter?: string;
  filter_type?: string;
  tag?: string[];
}

const { data, page, filters, base_url, filter, filter_type, tag } =
  Astro.props as Props;
const paginatedPosts = page.data;
const style: PageStyle =
  data?.style ??
  (paginatedPosts as unknown as { style?: PageStyle }).style ??
  {};
const sizes = getGridImageSizes(data?.style?.container || "md");
const template = style?.template ? style.template : "split";
let pagerSlug = base_url;
 

if (filter_type) pagerSlug += `/${filter_type}`;
if (filter) pagerSlug += `/${slugify(filter)}`;

const itemsWrapClass = () => {
  if (style.card_template === "grid")
    return `grid auto-grid-${style.container || "md"} gap-4 pb-32`;
  if (style.hero_template === "image")
    return `flex flex-wrap justify-center pt-14 pb-20 flex-grid gap-x-4 gap-y-8`;
  return `flex flex-wrap gap-x-4 gap-y-8 justify-center pb-32 flex-grid `;
};
---

{
  template === "split" && (
    <PageLayoutSplit
      {...page}
      {...data}
      {base_url}
      {filters}
      {filter}
      {filter_type}
      {tag}
    >
      {data.body && data.body !== " " && (
        <div
          class={`richtext ${style.content_class || "pb-14"}`}
          set:html={marked.parse(data.body)}
        />
      )}
      <ul class={`bloglist grid gap-4 pb-14`} data-pagefind-ignore="all">
        {page.data.map((post) => (
          <li>
            <ItemCardSmall content={post} {base_url} animate={true} />
          </li>
        ))}
      </ul>

      {page.lastPage > 1 && (
        <div class="-mb-14 mt-auto w-full pb-4 pt-20">
          <Pager
            totalPage={page.lastPage}
            currentPage={page.currentPage}
            url={pagerSlug}
          />
        </div>
      )}
    </PageLayoutSplit>
  )
}

{
  template === "full" && (
    <PageLayoutWide
      {...page}
      {...data}
      {filters}
      {filter}
      {filter_type}
      {base_url}
      {tag}
    >
      {data.body && data.body !== "" && (
        <section class={` ${style.content_class || "pb-14"}`}>
          <div
            class={`richtext container-${style.container || "md"}`}
            set:html={marked.parse(data.body)}
          />
        </section>
      )}

      <section data-pagefind-ignore="all">
        <ul class={`${itemsWrapClass()}`}>
          {page.data.map((post) => (
            <li>
              {style.card_template === "grid" && (
                <ItemCard content={post} {base_url} {sizes} animate={true} />
              )}
              {style.card_template === "flex" && (
                <ItemCardFlex content={post} {base_url} animate={true} />
              )}
            </li>
          ))}
        </ul>
        {page.lastPage > 1 && (
          <div class="container-md pb-4">
            <Pager
              totalPage={page.lastPage}
              currentPage={page.currentPage}
              url={pagerSlug}
            />
          </div>
        )}
      </section>
    </PageLayoutWide>
  )
}

<style>
  @reference "../styles/global.css";

  ul.bloglist {
    width: calc(100% + var(--container-spacing));
    margin-left: calc(var(--layout-spacing) * -1);
  }
  @media (width >= 40rem) {
    ul.bloglist {
      width: 100%;
      margin-left: 0;
    }
  }
  .flex-grid li {
    @apply flex flex-1 justify-center;
  }
</style>
