---
import BaseLayout from "./BaseLayout.astro";
import SmartPicture from "@components/media/SmartPicture.astro";
import ItemFilter from "@components/navigation/ItemFilter.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Block from "@components/block/Block.astro";
import Button from "@components/navigation/Button.astro";
import { surfaceClass } from "@util/surfaces";
import { sizesSplitHero, widthsViewport } from "@util/images";
import type { PageStyle } from "@src/types/page-style";

interface ButtonLink {
  href: string;
  label: string;
  icon?: string;
  icon_only?: boolean;
  color?: string;
  className?: string;
}

interface BlockSection {
  component: string;
  [key: string]: unknown;
}

interface Props {
  title?: string;
  description?: string;
  thumbnail?: string;
  og_image?: string;
  intro?: string;
  tag?: string[];
  filters?: string[];
  pubDate?: Date;
  base_url?: string;
  blocks?: BlockSection[];
  style?: PageStyle;
  filter?: string;
  filter_type?: string;
  hero_buttons?: ButtonLink[];
}

const {
  title,
  description,
  thumbnail,
  og_image,
  intro,
  tag,
  filters,
  pubDate,
  base_url,
  blocks,
  style,
  filter,
  filter_type,
  hero_buttons,
} = Astro.props as Props;

const { slug } = Astro.params;
const pageTitle = `${title} ${filter ? `#${filter}` : ""}`;
const hasBlocks = blocks && blocks.length > 0;
const heroSurface = surfaceClass(style?.hero_surface ?? "dark");
const heroOpacityRaw = style?.hero_image_opacity;
const heroOpacity =
  heroOpacityRaw === "" || heroOpacityRaw == null
    ? 0.7
    : Number(heroOpacityRaw);
const heroDim = Number(
  (1 - (Number.isFinite(heroOpacity) ? heroOpacity : 0.7)).toFixed(3),
);
---

<BaseLayout
  title={pageTitle}
  {description}
  pageClass={style?.page_class}
  {thumbnail}
  {og_image}
>
  <div class="page-split__grid">
    <div
      class="z-10"
      id="header"
      transition:name={`hero_${slug || Math.random()}`}
    >
      <div
        class={`${heroSurface} relative sticky top-0 overflow-hidden sm:h-screen`}
      >
        {
          thumbnail && (
            <>
              <SmartPicture
                src={thumbnail}
                sizes={sizesSplitHero()}
                widths={widthsViewport(1920)}
                priority
                alt={title}
                class="z-0 h-full w-full object-cover sm:h-screen"
              />
              {heroDim > 0 && (
                <div
                  class="pointer-events-none absolute inset-0 z-[1] bg-dark"
                  style={`opacity: ${heroDim}`}
                  aria-hidden="true"
                />
              )}
            </>
          )
        }

        <div
          class="page-split__title absolute inset-0 z-10 grid place-items-center bg-dark/20"
        >
          <div class="w-full">
            {
              pubDate && (
                <span class="text-overline">
                  <FormattedDate date={pubDate} />
                </span>
              )
            }
            <h1 class="title">
              {title}
            </h1>
            {intro && <div class="subtitle balance pt-4"> {intro}</div>}

            {
              hero_buttons && hero_buttons.length > 0 && (
                <div class="inline-flex flex-wrap  gap-4 py-8 ">
                  {hero_buttons.map((btn) => (
                    <Button {...btn} />
                  ))}
                </div>
              )
            }
            {
              tag && (
                <ItemFilter
                  filters={tag}
                  className="mt-4"
                  links={true}
                  {base_url}
                />
              )
            }

            {
              filters && (
                <ItemFilter
                  filters={filters}
                  className="mt-4"
                  links={true}
                  active={filter}
                  type={filter_type}
                  {base_url}
                />
              )
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="page-split__content z-0 mb-0 mt-8 w-full md:max-w-2xl md:pl-0 md:pr-8"
    >
      <div class={`flex h-full flex-col ${hasBlocks ? "pb-10" : "pb-20"}`}>
        <slot />

        {!hasBlocks && <slot name="nav" />}
      </div>
    </div>
  </div>
  {
    hasBlocks && (
      <>
        <div class={style?.block_class || "my-20"}>
          {blocks.map((section) => (
            <Block {...section} />
          ))}
        </div>
        <div class="container-md pb-20">
          <slot name="nav" />
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  @reference "../styles/global.css";

  .page-split__grid {
    @apply grid 2xl:gap-14;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (width >= 48rem) {
    .page-split__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (width >= 96rem) {
    .page-split__grid {
      grid-template-columns: 40vw minmax(0, 1fr);
    }
  }
  .page-split__title {
    padding: var(--layout-spacing);
  }
  .page-split__content {
    padding-inline: var(--layout-spacing);
  }
</style>

<style is:global>
  @reference "../styles/global.css";

  .page-split__content .img,
  .page-split__content iframe {
    width: calc(100% + var(--container-spacing));
    margin-left: calc(var(--layout-spacing) * -1);
    @apply my-10 h-auto;
  }
  @media (width >= 48rem) {
    .page-split__content .img,
    .page-split__content iframe {
      width: 100%;
      margin-left: 0;
    }
  }
  .page-split__content iframe {
    @apply aspect-video;
  }
</style>
