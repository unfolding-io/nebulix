---
import SmartPicture from "@components/media/SmartPicture.astro";
import Lightbox from "@components/media/Lightbox.astro";
import { t } from "@util/translate";
import { sizesMdx, widthsContainer } from "@util/images";
import { getLightboxImage } from "@util/lightbox";

const { slot, ...props } = Astro.props;
const imageName = props.src.split("/").pop().split(".")[0];
const imgAlt = imageName ? imageName : "no-name";
const ext = props.src.split(".").pop();

function isPixelBasedImage(extension) {
  const pixelBasedFormats = [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "bmp",
    "tiff",
    "webp",
    "ico",
  ];

  return pixelBasedFormats.includes(extension.toLowerCase());
}
const isSvg = !isPixelBasedImage(ext);
const lightbox = !isSvg ? await getLightboxImage(props.src) : null;
---

{
  !isSvg && lightbox && (
    <Lightbox
      src={lightbox.href}
      width={lightbox.width}
      height={lightbox.height}
      ariaLabel={t("enlarge_image")}
      className="img fade-up block"
    >
      <SmartPicture
        src={props.src}
        alt={imgAlt}
        widths={widthsContainer("sm")}
        sizes={sizesMdx()}
        class={props.class}
      />
    </Lightbox>
  )
}
{isSvg && <img {...props} alt={imgAlt} />}
