---
import { slugify } from "@util/helpers";

interface Props {
  filters: string[];
  className?: string;
  links?: boolean;
  active?: string;
  base_url?: string;
  type?: string;
}

const { filters, className, links, active, base_url, type } =
  Astro.props as Props;
---

<div
  class={`inline-flex md:flex gap-2 flex-wrap ${className ? className : ""}`}
>
  {
    !!links &&
      filters.map((filter) => (
        <a
          href={`/${base_url}${
            filter === active ? "" : `/${type || "tag"}/${slugify(filter)}`
          }`}
          class={`block rounded-md px-2 py-0.5 text-xs uppercase tracking-widest transition-all duration-300 hover:opacity-60 hover:underline
						${filter == active ? "underline" : ""} `}
        >
          {filter}
        </a>
      ))
  }
  {
    !links &&
      filters.map((filter) => (
        <span class=" block py-0.5 text-xs uppercase tracking-widest opacity-90">
          {filter}
        </span>
      ))
  }
</div>
