---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { resolveAsset } from "@util/assets";
import { widthsForDisplay } from "@util/images";

interface Props {
  src?: string | ImageMetadata | null;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  formats?: ("avif" | "webp" | "png" | "jpeg")[];
  /** Display width hint. Defaults to intrinsic asset width. */
  width?: number;
  /**
   * Display height hint. Defaults to intrinsic asset height so the image
   * service does not crop to a wrong aspect ratio.
   * Pass when CMS sets an aspect ratio override.
   */
  height?: number;
  /** When set (width/height ratio), height is derived from width. */
  aspect?: string | number | null;
  style?: string;
}

const {
  src,
  alt = "",
  widths: widthsProp,
  sizes = "100vw",
  class: className = "",
  loading = "lazy",
  formats = ["avif", "webp"],
  width: widthProp,
  height: heightProp,
  aspect,
  style,
} = Astro.props;

const image = typeof src === "string" ? resolveAsset(src) : src || undefined;

const width = widthProp ?? image?.width;
const aspectNum = aspect != null && aspect !== "" ? Number(aspect) : NaN;
const height =
  heightProp ??
  (width && Number.isFinite(aspectNum) && aspectNum > 0
    ? Math.round(width / aspectNum)
    : image?.height);

/** Prefer caller widths; otherwise derive from display width × 2 DPR. */
const widths =
  widthsProp ??
  (width ? widthsForDisplay(width) : widthsForDisplay(1280));
---

{
  image && (
    <Picture
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={formats}
      class={className}
      loading={loading}
      width={width}
      height={height}
      style={style}
    />
  )
}
