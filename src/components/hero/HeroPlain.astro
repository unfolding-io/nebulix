---
import Button from "@components/navigation/Button.astro";
import ItemFilter from "@components/navigation/ItemFilter.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { surfaceClass } from "@util/surfaces";
import type { PageStyle } from "@src/types/page-style";

interface ButtonLink {
  href: string;
  label: string;
  icon?: string;
  icon_only?: boolean;
  color?: string;
  className?: string;
}

interface Props {
  title?: string;
  hero_buttons?: ButtonLink[];
  intro?: string;
  tag?: string[];
  style?: PageStyle;
  pubDate?: Date;
  base_url?: string;
  filters?: string[];
  filter?: string;
  filter_type?: string;
}

const {
  title,
  hero_buttons,
  intro,
  tag,
  style,
  pubDate,
  base_url,
  filters,
  filter,
  filter_type,
} = Astro.props as Props;
const heroSurface = surfaceClass(style?.hero_surface);
---

<div
  class={`z-0 overflow-hidden ${heroSurface} ${style?.hero_class || ""}`}
  id="header"
>
  <div class="z-10 grid place-items-center">
    <div class="container-xl py-20">
      <div class="mx-auto max-w-3xl text-center">
        {
          pubDate && (
            <span class="text-overline">
              <FormattedDate date={pubDate} />
            </span>
          )
        }

        <h1 class="title">{title}</h1>
        {intro && <div class="subtitle balance pt-4"> {intro}</div>}
        {
          tag && (
            <ItemFilter
              filters={tag}
              className="mt-4 justify-center"
              links={true}
              {base_url}
            />
          )
        }

        {
          filters && (
            <ItemFilter
              filters={filters}
              className="mt-4 justify-center"
              links={true}
              active={filter}
              type={filter_type}
              {base_url}
            />
          )
        }
        {
          hero_buttons && (
            <div class="flex flex-wrap justify-center gap-4 py-8">
              {hero_buttons.map((btn) => (
                <Button {...btn} />
              ))}
            </div>
          )
        }
        <slot />
      </div>
    </div>
  </div>
</div>
