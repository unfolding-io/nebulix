---
import { marked } from "marked";
import Button from "@components/navigation/Button.astro";

interface ButtonLink {
  href: string;
  label: string;
  icon?: string;
  icon_only?: boolean;
  color?: string;
  className?: string;
}

interface Props {
  content?: string;
  container?: string;
  buttons?: ButtonLink[];
}

const { content, container, buttons } = Astro.props as Props;

const renderedContent = marked.parse(content ?? "");
---

<div class={`container-${container}  `} style="--animation-delay: 0.4s">
  <div set:html={renderedContent} class="richtext fade-up" />
  {
    buttons && (
      <div
        class="fade-up inline-flex flex-wrap gap-4 py-8"
        style="--animation-delay: 0.6s"
      >
        {buttons.map((btn) => (
          <Button {...btn} />
        ))}
      </div>
    )
  }
</div>
