---
import { formatPrice } from "@util/toLocale";
import SmartPicture from "@components/media/SmartPicture.astro";
import Lightbox from "@components/media/Lightbox.astro";
import { marked } from "marked";
import Label from "@components/menu/Label.astro";
import { slugify } from "@util/helpers";
import { t } from "@util/translate";
import { sizesMenuThumb, widthsGridCard } from "@util/images";
import { getLightboxImage } from "@util/lightbox";

const { categories } = Astro.props;

const thumbs: string[] = (categories || [])
  .flatMap((cat: { menu_items?: { thumbnail?: string }[] }) => cat.menu_items || [])
  .map((item: { thumbnail?: string }) => item.thumbnail)
  .filter((src: string | undefined): src is string => Boolean(src));

const lightboxBySrc = Object.fromEntries(
  (
    await Promise.all(
      [...new Set(thumbs)].map(async (src) => [src, await getLightboxImage(src)]),
    )
  ).filter(([, lb]) => lb),
);
---

<div class="grid gap-20 pb-20">
  {
    categories.map((cat) => (
      <div class="grid gap-20">
        <div class="balance mx-auto grid max-w-2xl gap-4 text-center">
          <div class="fade-up grid gap-4">
            <h2 class="title-md scroll-mt-20" id={`${slugify(cat.title)}`}>
              {cat.title}
            </h2>
            {cat.intro && <p class="lead"> {cat.intro}</p>}
          </div>
        </div>

        <ul class="auto-grid-lg menu-grid my-8 gap-10">
          {cat.menu_items.map((item) => {
            const lightbox = item.thumbnail
              ? lightboxBySrc[item.thumbnail]
              : null;
            return (
              <li>
                <div class="fade-up flex h-full scroll-m-0 flex-col ">
                  {item.thumbnail && lightbox && (
                    <Lightbox
                      src={lightbox.href}
                      width={lightbox.width}
                      height={lightbox.height}
                      ariaLabel={t("enlarge_image")}
                      className="img block pb-2"
                    >
                      <div class="overflow-hidden rounded-md">
                        <SmartPicture
                          src={item.thumbnail}
                          widths={widthsGridCard("lg")}
                          sizes={sizesMenuThumb()}
                          alt={item.title}
                          class="h-full w-full object-cover"
                        />
                      </div>
                    </Lightbox>
                  )}

                  <div>
                    <h3 class="subtitle balance flex w-full flex-wrap font-bold">
                      {item.title}
                      <span class="ml-auto" />

                      {item.details.labels &&
                        item.details.labels.map((name) => (
                          <Label name={name} />
                        ))}
                    </h3>
                  </div>

                  {item.intro && (
                    <div
                      class="balance richtext"
                      set:html={marked.parse(item.intro)}
                    />
                  )}

                  {item.price && (
                    <div class="mt-auto flex w-full justify-between  gap-4 pt-4">
                      <div class="flex flex-wrap content-end justify-start">
                        {item.details.allergens &&
                          item.details.allergens.map((name) => (
                            <Label name={name} />
                          ))}
                      </div>
                      <div class="align-end flex flex-col justify-end">
                        {item.price.map((price, index) => (
                          <div class="ml-auto flex items-center justify-between gap-4">
                            {price.label && (
                              <span class="text-xs"> {price.label}</span>
                            )}
                            {price.price && (
                              <span
                                class={` ${
                                  index == 0 ? "text-lg font-bold" : ""
                                }`}
                              >
                                {formatPrice(price.price)}
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
@reference "../../styles/global.css";

  .menu-grid {
    --grid-spacing: 3rem;
    .img {
      @apply block;
      width: calc(100% + var(--container-spacing));
      margin-inline: calc(var(--layout-spacing) * -1);

      @media (width >= 40rem) {
        width: 100%;
        margin-left: 0;
      }
    }
  }
</style>
